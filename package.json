{
  "name": "pi-deepread",
  "version": "0.2.1",
  "description": "Full-text web search and document reading for Pi \u2014 3 tools, compact prompt surface. DeepSeek need_content search, keyless + Exa fallback, local anymd conversion.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "web-search",
    "deepseek",
    "exa",
    "pdf",
    "llm-tools"
  ],
  "license": "MIT",
  "author": "Eric Zhou",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pumblus/pi-deepread.git"
  },
  "homepage": "https://github.com/pumblus/pi-deepread#readme",
  "bugs": {
    "url": "https://github.com/pumblus/pi-deepread/issues"
  },
  "files": [
    "extensions/",
    "bin/",
    "docs/BUILD_LOG.md",
    "docs/BUILD_LOG_zh-CN.md",
    "README.md",
    "README_zh-CN.md",
    "LICENSE",
    "docs/TESTING.md",
    "docs/TESTING_zh-CN.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/web-access.ts"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && node --experimental-strip-types bench/sanitize.ts && npm run bench:prompt",
    "bench": "node --experimental-strip-types bench/scenarios.ts",
    "bench:prompt": "node --experimental-strip-types bench/prompt-surface.ts",
    "test:pdf": "node --experimental-strip-types tests/integration/pdf-smoke.ts"
  }
}
